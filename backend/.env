# ===== SERVER =====
PORT=5000
NODE_ENV=production

# ===== FRONTEND URL (for CORS) - CHANGE THIS to your EC2 public IP/domain =====
FRONTEND_URL=http://localhost:5173

# ===== POSTGRESQL DATABASE - CHANGE THESE =====
# For AWS RDS, DB_HOST is your RDS endpoint (RDS console -> Databases -> your instance -> "Endpoint & port")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devopsai
DB_USER=devopsai_user
DB_PASSWORD=change_this_password
# RDS requires SSL (leave true). Set to false only for local/self-hosted Postgres with no SSL.
DB_SSL=true

# ===== JWT - CHANGE THIS SECRET (use: openssl rand -base64 48) =====
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d


AI_API_KEY=gsk_your_groq_api_key

AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=models/gemini-3.6-flash

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
